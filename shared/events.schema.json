{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MouseEvents",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["move", "click"]
      },
      "x": {
        "type": "number",
        "description": "Global X coordinate"
      },
      "y": {
        "type": "number",
        "description": "Global Y coordinate"
      },
      "t": {
        "type": "number",
        "description": "Timestamp in milliseconds since start of recording"
      }
    },
    "required": ["type", "x", "y", "t"]
  }
}
